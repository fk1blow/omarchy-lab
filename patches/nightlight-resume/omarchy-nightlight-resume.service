[Unit]
Description=Re-apply hyprsunset temperature after resume
# Needs HYPRLAND_INSTANCE_SIGNATURE and WAYLAND_DISPLAY in the user manager, which
# uwsm imports; same conditions omarchy-sleep-lock.service uses.
After=dbus.socket wayland-session-waitenv.service
Requires=dbus.socket
PartOf=graphical-session.target
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-nightlight-resume
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
